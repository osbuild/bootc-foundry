# vim: set ft=dockerfile:
# -*- mode: dockerfile-mode -*-
# code: language=dockerfile insertSpaces=true tabSize=4

FROM registry.redhat.io/rhel10/rhel-bootc:latest

ARG TARGETARCH

# Copy arch-specific files before dnf install
COPY gcp-${TARGETARCH}/etc/ /etc/
COPY gcp-${TARGETARCH}/usr/ /usr/

RUN dnf -y install \
        firewalld \
        google-compute-engine \
        google-osconfig-agent
    && dnf clean all

RUN firewall-offline-cmd --set-default-zone=trusted

RUN systemctl enable \
    sshd \
    firewalld \
    chronyd

RUN systemctl disable \
    reboot.target \
    sshd-keygen@

COPY gcp/etc/ /etc/

COPY rhel-10-gcp /root/Containerfile
